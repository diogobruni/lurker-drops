---
import CountUp from './react-bits/CountUp/CountUp';
import Popup from './Popup.astro';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const a = dict.app;
const t = a.tab;
const row = dict.ui.rows[0];
const [channel, game] = row.meta.split(' · ');
---

<section class="section" id="tabs" aria-labelledby="tabs-h">
  <div class="wrap">
    <div class="grid">
      <div class="span-5"><h2 id="tabs-h">{a.title} <span class="muted">{a.titleMuted}</span></h2></div>
      <div class="span-6 start-7 stack-4">
        <p class="t-lead">{a.text}</p>
        <p><a class="link" href="#how">{a.link}</a></p>
      </div>
    </div>

    <div class="ui app fill" role="img" aria-label={a.label}>
      <div class="app__pane app__pane--list">
        <Popup dict={dict} part="home" />
      </div>

      <div class="app__pane app__pane--open">
        <div class="tw is-claimed" data-tw-loop>
          <Popup dict={dict} part="overlay" />
          <div class="tw__body">
            <div class="tw__main">
              <div class="tw__player">
                <div class="tw__scene" aria-hidden="true"><i></i><i></i><i></i></div>
                <span class="tw__live">{t.live}</span>
                <span class="tw__muted"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6h2.5L9 3v10L5.5 10H3z"></path><path d="m11 6 3 4M14 6l-3 4"></path></svg></span>
              </div>
              <div class="tw__meta">
                <span class="ui-avatar" data-tone="4">BR</span>
                <div>
                  <b>{channel}</b>
                  <p>{row.title}</p>
                  <p class="tw__tags"><span>{game}</span><span>Drops</span></p>
                </div>
                <span class="tw__viewers">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="6" r="2.5"></circle><path d="M3.5 13.5c.6-2.3 2.4-3.5 4.5-3.5s3.9 1.2 4.5 3.5"></path></svg>
                  <CountUp client:visible from={3412} to={3518} duration={2.4} separator="," trigger="view" />
                </span>
              </div>
            </div>
            <aside class="tw__chat">
              <p class="tw__chat-h">{t.chat}</p>
              <ul class="tw__msgs">
                {t.messages.map((m, i) => (
                  <li><b data-c={i % 4}>{m.who}</b> {m.text}</li>
                ))}
              </ul>
              <div class="tw__points">
                <span class="tw__chest is-gone" data-tw-chest title={t.chest}>
                  <span class="tw__gift" aria-hidden="true"></span>
                </span>
                <span class="tw__claimed">
                  <span class="t-success-check" data-state="in" data-tw-check aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none"><path d="m3.5 8.4 2.8 2.8 6.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </span>
                  <span data-tw-claimed>{t.claimed}</span>
                </span>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
