---
import Popup from './Popup.astro';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const f = dict.features;
const sage = JSON.stringify({ bg: '#cdd6c6', surface: '#dce3d6', ink: '#262d24', accent: '#6c8e63' });
const still = JSON.stringify({ drift: 0 });
const panel = (seed: number) => ({ 'data-fx': 'grain-gradient', 'data-fx-seed': seed, 'data-fx-palette': sage, 'data-fx-params': still });
---

<section class="section section--fit" id="features" aria-labelledby="features-h">
  <div class="wrap">
    <div class="group">
      <div class="section-head">
        <h2 id="features-h">{f.title} <span class="muted">{f.titleMuted}</span></h2>
      </div>
      <div class="grid">
        <article class="card card--row card--open span-6">
          <h3>{f.items[0].title}</h3>
          <p>{f.items[0].text}</p>
          <div class="panel" {...panel(21)}>
            <div class="stage stage--fade-b">
              <div class="at-rise fit" style="--fit-max:400px;--ax:max(24px, 50% - 200px);--ay:40px;--ay-sm:24px">
                <Popup dict={dict} part="preset" />
              </div>
            </div>
          </div>
        </article>

        <article class="card card--row card--open span-6">
          <h3>{f.items[1].title}</h3>
          <p>{f.items[1].text}</p>
          <div class="panel" {...panel(34)}>
            <div class="stage stage--fade-b">
              <div class="at-rise fit" style="--fit-max:400px;--ax:max(24px, 50% - 200px);--ay:40px;--ay-sm:24px">
                <Popup dict={dict} part="options" />
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>

    <div class="grid">
      <article class="card card--row card--open span-6">
        <h3>{f.items[2].title}</h3>
        <p>{f.items[2].text}</p>
        <div class="panel" {...panel(47)}>
          <div class="stage stage--fade-b">
            <div class="at-rise fit" style="--fit-max:360px;--ax:max(24px, 50% - 180px);--ay:40px;--ay-sm:24px">
              <div class="twchat" data-chat role="img" aria-label={`${f.chat.title}: ${f.chat.down} ${f.chat.back}`}>
                <p class="twchat__h">{f.chat.title}</p>
                <ul class="twchat__list">
                  {f.chat.messages.map((m, i) => <li><b data-c={i}>{m.who}</b> {m.text}</li>)}
                  <li class="twchat__sys twchat__down" data-chat-down>{f.chat.down}</li>
                  <li class="twchat__sys twchat__back" data-chat-back>{f.chat.back}</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--row card--open span-6">
        <h3>{f.items[3].title}</h3>
        <p>{f.items[3].text}</p>
        <div class="panel" {...panel(58)}>
          <div class="stage stage--fade-b">
            <div class="at-rise fit" style="--fit-max:360px;--ax:max(24px, 50% - 180px);--ay:56px;--ay-sm:40px">
              <div class="twpts is-claimed" data-chest role="img" aria-label={`${f.points.label}: ${f.points.value}`}>
                <p class="twpts__label">{f.points.label}</p>
                <span class="twpts__bal"><span class="twpts__ico" aria-hidden="true"></span><b data-chest-points>{f.points.value}</b></span>
                <span class="twpts__chest is-gone" data-chest-btn><span class="tw__gift" aria-hidden="true"></span></span>
                <span class="twpts__plus" data-chest-label>
                  <span class="t-success-check" data-state="in" data-chest-check aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none"><path d="m3.5 8.4 2.8 2.8 6.2-6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  </span>{f.points.claimed}
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
