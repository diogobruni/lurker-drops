---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { CHROME_WEB_STORE_URL, dictionaries, GITHUB_URL, href, locales } from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

const nav = [
  { label: dict.nav.tabs, href: '#tabs' },
  { label: dict.nav.features, href: '#features' },
  { label: dict.nav.how, href: '#how' },
  { label: dict.nav.faq, href: '#faq' },
];
---

<header class="nav nav--ld">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">{dict.skip}</a>
    <a class="nav__logo" href="#top">
      <Image class="logo-img" src={icon} alt="" width={28} height={28} loading="eager" />Lurker Drops
    </a>
    <nav class="nav__links" aria-label={dict.nav.primary}>
      {nav.map((item) => (
        <div class="nav__item"><a class="nav__link" href={item.href}>{item.label}</a></div>
      ))}
    </nav>
    <div class="nav__actions">
      <nav class="lang-seg" aria-label={dict.nav.language}>
        {locales.map((locale) => (
          <a
            href={href(dictionaries[locale].path)}
            hreflang={dictionaries[locale].htmlLang}
            lang={dictionaries[locale].htmlLang}
            aria-label={`${dictionaries[locale].langName} (${dictionaries[locale].label})`}
            aria-current={locale === dict.locale ? 'true' : undefined}
          >
            {dictionaries[locale].label}
          </a>
        ))}
      </nav>
      <button
        class="icon-btn theme-btn t-icon-swap"
        type="button"
        data-theme-toggle
        data-state="a"
        aria-pressed="false"
        aria-label={dict.nav.themeDark}
        data-label-dark={dict.nav.themeDark}
        data-label-light={dict.nav.themeLight}
      >
        <span class="t-icon" data-icon="a"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg></span>
        <span class="t-icon" data-icon="b"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg></span>
      </button>
      <a class="icon-btn" href={GITHUB_URL} target="_blank" rel="noopener" aria-label={dict.nav.github}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-fill"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"></path></svg>
      </a>
      <a class="btn btn--primary" href={CHROME_WEB_STORE_URL} target="_blank" rel="noopener">
        {dict.nav.cta}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg>
      </a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label={dict.nav.menu}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>
