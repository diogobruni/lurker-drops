---
// Faithful copies of the extension's real screens (src/popup/screens), in its own dark look.
// Labels come from the extension's locale through dict.ui; nothing here is a screen the app lacks.
import { Image } from 'astro:assets';
import type { Dictionary } from '../i18n/en';
import icon from '../assets/icon.png';
import thumb1 from '../assets/thumb-1.jpg';
import thumb2 from '../assets/thumb-2.jpg';
import thumbPreview from '../assets/thumb-preview.jpg';

type Part = 'home' | 'form' | 'options' | 'turnon' | 'preset' | 'presets' | 'overlay';

interface Props {
  dict: Dictionary;
  part: Part;
  /* above the fold (the hero): load its pictures at once */
  eager?: boolean;
}

const { dict, part, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const u = dict.ui;
const thumbs = [thumb1, thumb2];

/* lucide icons the popup uses (24px grid) */
const ic = {
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
  ext: '<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  back: '<path d="m12 19-7-7 7-7M19 12H5"/>',
  plus: '<path d="M5 12h14M12 5v14"/>',
  power: '<path d="M12 2v10M18.4 6.6a9 9 0 1 1-12.77.04"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  tag: '<path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"/><circle cx="7.5" cy="7.5" r=".5"/>',
  volx: '<path d="M11 4.7a.7.7 0 0 0-1.2-.5L6.4 7.6A1.4 1.4 0 0 1 5.4 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.4a1.4 1.4 0 0 1 1 .4l3.4 3.4a.7.7 0 0 0 1.2-.5zM22 9l-6 6M16 9l6 6"/>',
  radar: '<path d="M19.07 4.93A10 10 0 0 0 6.99 3.34M4 6h.01M2.29 9.62A10 10 0 1 0 21.31 8.35M16.24 7.76A6 6 0 1 0 8.23 16.67M12 18h.01M17.99 11.66A6 6 0 0 1 15.77 16.67"/><circle cx="12" cy="12" r="2"/><path d="m13.41 10.59 5.66-5.66"/>',
  pencil: '<path d="M21.2 6.8a2.8 2.8 0 0 0-4-4L3.8 16.2a2 2 0 0 0-.5.8l-1.3 4.4a.5.5 0 0 0 .6.6l4.4-1.3a2 2 0 0 0 .8-.5zM15 5l4 4"/>',
  chev: '<path d="m7 15 5 5 5-5M7 9l5-5 5 5"/>',
  sliders: '<path d="M20 7h-9M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
  save: '<path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  trash: '<path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/>',
  tv: '<rect width="20" height="15" x="2" y="7" rx="2" ry="2"/><path d="m17 2-5 5-5-5"/>',
  grip: '<circle cx="9" cy="12" r="1"/><circle cx="9" cy="5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="19" r="1"/>',
  star: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
  ban: '<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>',
  gamepad: '<path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/>',
};
const opts = [
  { label: u.muted, hint: u.mutedHint },
  { label: u.pursue, hint: u.pursueHint },
  { label: u.newTab, hint: u.newTabHint },
];
const fields = [
  { label: u.nameLabel, value: u.presetName, hint: u.nameHint },
  { label: u.category, value: u.categoryValue, chev: true, optional: true, hint: u.categoryHint },
  { label: u.titleFilter, value: u.titleFilterValue, optional: true, hint: u.titleFilterHint },
  { label: u.favorites, chips: u.favoritesValue, optional: true, hint: u.favoritesHint },
  { label: u.blacklist, chips: u.blacklistValue, optional: true, hint: u.blacklistHint },
];
/* "Favorites: 3 · Blocked: 1 · In use: 1" */
const [favCount, blockedCount, inUseCount] = u.presetCounts.split(' · ');
const back = part === 'form';
---

<div class:list={['pp', `pp--${part}`]}>
  {(part === 'home' || part === 'form') && (
    <div class="pp-nav">
      {back ? (
        <span class="pp-ib"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.back} /></span>
      ) : (
        <Image class="pp-logo" src={icon} alt="" width={32} height={32} loading={loading} />
      )}
      <div class="pp-nav__t"><b>{back ? u.newLurker : 'Lurker Drops'}</b><small>{back ? u.lurkerSettings : u.tagline}</small></div>
      <span class="pp-ib pp-dim"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.info} /></span>
      <span class="pp-ib pp-dim"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.ext} /></span>
    </div>
  )}

  {part === 'home' && (
    <div class="pp-body">
      <div class="pp-sec">
        <span class="pp-label pp-eyebrow">{u.lurkingTabs}</span>
        <span class="pp-badge"><i class="pp-live"></i>{u.active}</span>
        <span class="pp-btn pp-btn--primary pp-btn--sm"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.plus} />{u.add}</span>
      </div>
      <div class="pp-rows">
        {u.rows.map((r, i) => (
          <div class="pp-card pp-row" data-row={i}>
            <span class="pp-row__bar"></span>
            <div class="pp-row__top">
              <svg class="pp-i pp-i--lg pp-grip" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.grip} />
              <span class="pp-thumb">
                <svg class="pp-i pp-i--lg pp-thumb__tv" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.tv} />
                <Image src={thumbs[i % 2]} alt="" width={75} height={42} loading={loading} />
                <span class="pp-thumb__live"><i class="pp-live"></i>live</span>
              </span>
              <span class="pp-row__t"><b>{r.title}</b><small>{r.meta}</small><small class="pp-tag"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.tag} />{r.preset}</small></span>
              <span class="pp-row__x">
                <span class="pp-switch" aria-hidden="true"><i></i></span>
                <span class="pp-ib pp-dim"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.trash} /></span>
              </span>
            </div>
            <div class="pp-row__acts">
              <span><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.ext} />{u.goTo}</span>
              <span><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.volx} />{u.unmute}</span>
              <span class="pp-violet"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.radar} />{u.pursueOn}</span>
              <span class="pp-push"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.pencil} />{u.edit}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="pp-foot">{u.footer}</p>
    </div>
  )}

  {part === 'form' && (
    <div class="pp-body">
      <p class="pp-label">{u.preset}</p>
      <div class="pp-select-row">
        <span class="pp-input">{u.presetValue}<svg class="pp-i pp-dim" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.chev} /></span>
        <span class="pp-sq"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.sliders} /></span>
      </div>
    </div>
  )}

  {(part === 'form' || part === 'turnon') && (
    <div class="pp-body">
      <div class="pp-card pp-prev">
        <p class="pp-label">{u.livePreview}</p>
        <div class="pp-prev__row">
          <span class="pp-prev__img">
            <svg class="pp-i pp-i--lg pp-thumb__tv" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.tv} />
            <Image src={thumbPreview} alt="" width={96} height={56} loading={loading} />
            <i class="pp-prev__dot"></i>
          </span>
          <span><b>{u.previewTitle}</b><small>{u.previewMeta}</small><em>{u.previewViewers}</em></span>
        </div>
      </div>
    </div>
  )}

  {(part === 'form' || part === 'options') && (
    <div class="pp-body">
      {opts.map((o) => (
        <div class="pp-opt">
          <span class="pp-box"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.check} /></span>
          <span><b>{o.label}</b><small>{o.hint}</small></span>
        </div>
      ))}
    </div>
  )}

  {(part === 'form' || part === 'turnon') && (
    <div class="pp-bar">
      <span class="pp-btn pp-btn--ghost">{u.cancel}</span>
      <span class="pp-btn pp-btn--primary" data-turnon><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.save} />{u.turnOn}</span>
    </div>
  )}

  {part === 'preset' && (
    <div class="pp-body pp-fields">
      {fields.map((f) => (
        <div class="pp-field">
          <span class="pp-field__h"><span>{f.label}</span>{f.optional && <small>{u.optional}</small>}</span>
          <span class:list={['pp-input', f.chips && 'pp-input--chips']}>
            {f.chips ? f.chips.map((c) => (
              <span class="pp-chip">@{c}<svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.x} /></span>
            )) : f.value}
            {(f.chev || f.chips) && <svg class:list={['pp-i', 'pp-dim', f.chips && 'pp-push']} viewBox="0 0 24 24" aria-hidden="true" set:html={ic.chev} />}
          </span>
          <small class="pp-hint">{f.hint}</small>
        </div>
      ))}
    </div>
  )}
  {part === 'preset' && (
    <div class="pp-bar">
      <span class="pp-btn pp-btn--ghost">{u.cancel}</span>
      <span class="pp-btn pp-btn--primary"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.save} />{u.savePreset}</span>
    </div>
  )}

  {part === 'presets' && (
    <div class="pp-body pp-body--tight">
      <span class="pp-btn pp-btn--primary pp-btn--full"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.plus} />{u.newPreset}</span>
      <div class="pp-sec pp-sec--between"><span class="pp-label pp-eyebrow">{u.savedPresets}</span><small class="pp-total">{u.total}</small></div>
      <div class="pp-card pp-pre">
        <div class="pp-pre__t">
          <b>{u.presetName}</b><small>{u.presetSummary}</small>
          <span class="pp-pre__n">
            <span><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.star} />{favCount}</span>
            <span><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.ban} />{blockedCount}</span>
            <span class="pp-badge"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.tv} />{inUseCount}</span>
          </span>
        </div>
        <span class="pp-row__x pp-dim">
          <span class="pp-ib"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.pencil} /></span>
          <span class="pp-ib"><svg class="pp-i" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.trash} /></span>
        </span>
      </div>
      <p class="pp-tip"><svg class="pp-i pp-i--lg" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.gamepad} />{u.tip}</p>
    </div>
  )}

  {part === 'overlay' && (
    <div class="pp-ov">
      <span class="pp-ov__dot"></span>
      <span class="pp-ov__t"><b>{u.overlayTitle}</b><small>{u.overlaySubtitle}</small></span>
      <span class="pp-ov__btn">{u.overlayOff}</span>
    </div>
  )}
</div>
