---
import BaseLayout from '../layouts/BaseLayout.astro';
import { en } from '../i18n/en';
import { href } from '../i18n';
---

<BaseLayout dict={en}>
  <main id="main" class="grid min-h-screen place-items-center px-6 text-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-soft">404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Page not found
      </h1>
      <p class="mt-3 text-zinc-400">The page you are looking for does not exist.</p>
      <a
        href={href('/')}
        class="mt-8 inline-flex h-11 items-center justify-center rounded-xl bg-brand px-5 text-sm font-semibold text-white transition hover:bg-brand-strong"
      >
        Back to Lurker Drops
      </a>
    </div>
  </main>
</BaseLayout>
