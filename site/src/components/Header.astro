---
import { asset, CHROME_WEB_STORE_URL, dictionaries, GITHUB_URL, href, locales } from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

const nav = [
  { label: dict.nav.features, href: '#features' },
  { label: dict.nav.how, href: '#how' },
  { label: dict.nav.faq, href: '#faq' },
  { label: dict.nav.install, href: '#install' },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={href(dict.path)} class="flex shrink-0 items-center gap-2.5">
      <img
        src={asset('icon.png')}
        alt=""
        width="32"
        height="32"
        class="rounded-lg"
      />
      <span class="text-sm font-semibold tracking-tight text-white">Lurker Drops</span>
    </a>

    <nav aria-label={dict.nav.primary} class="hidden items-center gap-6 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-zinc-400 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <nav aria-label={dict.nav.language} class="flex items-center rounded-lg border border-white/10 p-0.5">
        {
          locales.map((locale) => (
            <a
              href={href(dictionaries[locale].path)}
              hreflang={dictionaries[locale].htmlLang}
              aria-current={locale === dict.locale ? 'page' : undefined}
              class:list={[
                'rounded-md px-2 py-1 text-[11px] font-semibold transition-colors',
                locale === dict.locale
                  ? 'bg-white/10 text-white'
                  : 'text-zinc-400 hover:text-zinc-200',
              ]}
            >
              {dictionaries[locale].label}
            </a>
          ))
        }
      </nav>

      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={dict.nav.github}
        class="hidden size-9 items-center justify-center rounded-lg text-zinc-400 transition-colors hover:bg-white/5 hover:text-white sm:flex"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
        </svg>
      </a>

      <a
        href={CHROME_WEB_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-brand-solid px-3.5 text-xs font-semibold text-white transition-colors hover:bg-brand-solid-hover"
      >
        {dict.nav.install}
      </a>
    </div>
  </div>
</header>
