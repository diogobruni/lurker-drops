---
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="how" class="relative border-t border-white/5 py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-gradient-to-b from-brand/5 to-transparent">
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft">
        {dict.how.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {dict.how.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        {dict.how.subtitle}
      </p>
    </div>

    <ol class="mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
      {
        dict.how.steps.map((step, index) => (
          <li class="relative border-l border-white/10 pl-5 md:border-l-0 md:border-t md:pl-0 md:pt-6">
            <span
              class="absolute -left-px top-0 h-10 w-px bg-gradient-to-b from-brand to-transparent md:-top-px md:left-0 md:h-px md:w-16 md:bg-gradient-to-r"
              aria-hidden="true"
            />
            <span class="text-sm font-semibold tabular-nums text-brand-soft">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-10 flex items-start gap-2 text-sm text-zinc-500">
      <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
      {dict.how.note}
    </p>
  </div>
</section>
