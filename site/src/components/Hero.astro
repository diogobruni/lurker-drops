---
import { Image } from 'astro:assets';
import { ArrowRight, Check, Store, Sparkles } from '@lucide/astro';
import heroImage from '../assets/hero-image.png';
import { CHROME_WEB_STORE_URL } from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-0 h-[560px] w-[860px] max-w-none -translate-x-1/2 rounded-full bg-brand/15 blur-[120px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black_25%,transparent_75%)]"
    >
    </div>
  </div>

  <div
    class="mx-auto grid max-w-6xl gap-14 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1fr_1.12fr] lg:items-center lg:gap-12 lg:pb-28 lg:pt-24"
  >
    <div class="min-w-0">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 text-xs font-medium text-brand-soft"
      >
        <Sparkles size={13} aria-hidden="true" />
        {dict.hero.badge}
      </p>

      <h1
        class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        {dict.hero.title}{' '}
        <span
          class="bg-gradient-to-r from-brand-soft via-brand to-brand-strong bg-clip-text text-transparent"
        >
          {dict.hero.titleAccent}
        </span>
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-400 sm:text-lg">
        {dict.hero.subtitle}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={CHROME_WEB_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-brand-solid px-6 text-sm font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-solid-hover hover:shadow-brand/40"
        >
          <Store size={17} aria-hidden="true" />
          {dict.hero.primaryCta}
        </a>

        <a
          href="#how"
          class="inline-flex h-12 items-center justify-center gap-1.5 rounded-xl border border-white/10 px-5 text-sm font-medium text-zinc-300 transition hover:border-white/20 hover:text-white"
        >
          {dict.hero.secondaryCta}
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>

      <p class="mt-3 text-xs text-zinc-400">{dict.hero.primaryNote}</p>

      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2">
        {
          dict.hero.trust.map((item) => (
            <li class="flex items-center gap-1.5 text-xs text-zinc-400">
              <Check size={13} class="text-live" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full min-w-0 max-w-[35rem] lg:mx-0 lg:justify-self-end">
      <div class="absolute inset-4 rounded-full bg-brand/25 blur-3xl" aria-hidden="true"></div>
      <Image
        src={heroImage}
        alt={dict.hero.imageAlt}
        widths={[448, 720, 1000]}
        sizes="(min-width: 1024px) 35rem, 90vw"
        format="webp"
        quality={82}
        priority
        class="relative h-auto w-full animate-float"
      />
    </div>
  </div>
</section>
