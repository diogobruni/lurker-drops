---
import { Funnel, Gift, Layers, MessageCircle, RefreshCw, VolumeX } from '@lucide/astro';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const icons = [Funnel, Layers, RefreshCw, VolumeX, MessageCircle, Gift];
---

<section id="features" class="border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft">
        {dict.features.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {dict.features.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        {dict.features.subtitle}
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        dict.features.items.map((item, index) => {
          const Icon = icons[index % icons.length];
          return (
            <li class="group rounded-2xl border border-white/5 bg-surface/60 p-6 transition hover:border-brand/30 hover:bg-surface">
              <span class="grid size-10 place-items-center rounded-xl bg-brand/10 text-brand-soft transition group-hover:bg-brand/15">
                <Icon size={18} aria-hidden="true" />
              </span>
              <h3 class="mt-4 text-base font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.text}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
