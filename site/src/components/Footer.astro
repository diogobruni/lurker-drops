---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import {
  CHROME_WEB_STORE_URL,
  dictionaries,
  DOWNLOAD_URL,
  GITHUB_URL,
  href,
  locales,
  RELEASES_URL,
} from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const f = dict.footer;
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener' };
---

<footer class="footer closing footer--statement" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div><h2 id="close-h">{dict.close.title}</h2><p class="t-lead">{dict.close.lead}</p></div>
        <a class="btn btn--primary" href={CHROME_WEB_STORE_URL} {...ext}>
          {dict.nav.cta}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg>
        </a>
      </div>
      <p class="close__word" aria-hidden="true">Lurker Drops</p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="#top"><Image class="logo-img" src={icon} alt="" width={28} height={28} loading="lazy" />Lurker Drops</a>
          <p class="footer__lede">{f.lede}</p>
          <p class="t-small muted">{f.disclaimer}</p>
        </div>
        <div class="span-2 footer__col">
          <h3>{f.page}</h3>
          <ul>
            <li><a href="#tabs">{dict.nav.tabs}</a></li>
            <li><a href="#features">{dict.nav.features}</a></li>
            <li><a href="#how">{dict.nav.how}</a></li>
            <li><a href="#faq">{dict.nav.faq}</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>{f.get}</h3>
          <ul>
            <li><a href={CHROME_WEB_STORE_URL} {...ext}>{f.store}</a></li>
            <li><a href={DOWNLOAD_URL}>{f.zip}</a></li>
            <li><a href={RELEASES_URL} {...ext}>{f.releases}</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>{f.project}</h3>
          <ul>
            <li><a href={GITHUB_URL} {...ext}>{f.source}</a></li>
            <li><a href={`${GITHUB_URL}/issues`} {...ext}>{f.issues}</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>{f.language}</h3>
          <ul>
            {locales.map((locale) => (
              <li>
                <a
                  href={href(dictionaries[locale].path)}
                  hreflang={dictionaries[locale].htmlLang}
                aria-label={dictionaries[locale].langName}
                  lang={dictionaries[locale].htmlLang}
                  aria-current={locale === dict.locale ? 'true' : undefined}
                >
                  {dictionaries[locale].langName}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} Lurker Drops</span>
      </div>
    </div>
  </div>
</footer>

<nav class="actionbar" aria-label={dict.nav.cta}>
  <a class="btn btn--primary" href={CHROME_WEB_STORE_URL} target="_blank" rel="noopener">{dict.nav.cta}</a>
</nav>
