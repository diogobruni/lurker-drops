---
import { Package } from '@lucide/astro';
import { asset, GITHUB_URL, href, RELEASES_URL } from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <a href={href(dict.path)} class="flex items-center gap-2.5">
          <img src={asset('icon.png')} alt="" width="28" height="28" class="rounded-md" />
          <span class="text-sm font-semibold text-white">Lurker Drops</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-zinc-500">{dict.footer.tagline}</p>
      </div>

      <nav aria-label="Lurker Drops" class="flex flex-col gap-2 text-sm sm:items-end">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-zinc-400 transition-colors hover:text-white"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
          </svg>
          {dict.footer.github}
        </a>
        <a
          href={`${RELEASES_URL}/latest`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-zinc-400 transition-colors hover:text-white"
        >
          <Package size={15} aria-hidden="true" />
          {dict.footer.releases}
        </a>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/5 pt-6 text-xs text-zinc-600">
      <p>{dict.footer.disclaimer}</p>
      <p>{dict.footer.madeBy} · {year}</p>
    </div>
  </div>
</footer>
