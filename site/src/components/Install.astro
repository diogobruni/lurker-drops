---
import { Store, Download } from '@lucide/astro';
import { CHROME_WEB_STORE_URL, DOWNLOAD_URL } from '../i18n';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="install" class="border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft">
        {dict.install.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {dict.install.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        {dict.install.subtitle}
      </p>

      <a
        href={CHROME_WEB_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-brand-solid px-6 text-sm font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-solid-hover hover:shadow-brand/40"
      >
        <Store size={17} aria-hidden="true" />
        {dict.install.cta}
      </a>

      <p class="mt-4 max-w-sm text-xs leading-relaxed text-zinc-400">
        {dict.install.note}
      </p>
    </div>

    <div>
      <ol class="space-y-3">
        {
          dict.install.steps.map((step, index) => (
            <li class="flex gap-4 rounded-2xl border border-white/5 bg-surface/60 p-5">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg border border-brand/20 bg-brand/10 text-xs font-semibold text-brand-soft">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-semibold text-white">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-400">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-6xl px-4 sm:px-6">
    <div
      id="manual-install"
      class="scroll-mt-24 rounded-2xl border border-white/5 bg-surface/40 p-6 sm:p-8"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-base font-semibold text-white">{dict.install.alternative.title}</h3>
          <p class="mt-1 text-sm text-zinc-400">
            {dict.install.alternative.prompt} {dict.install.alternative.note}
          </p>
        </div>
        <a
          href={DOWNLOAD_URL}
          class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-white/10 px-5 text-sm font-medium text-zinc-200 transition hover:border-white/20 hover:text-white"
        >
          <Download size={16} aria-hidden="true" />
          {dict.install.alternative.cta}
        </a>
      </div>

      <ol class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          dict.install.alternative.steps.map((step, index) => (
            <li class="flex gap-3 rounded-xl border border-white/5 bg-canvas/40 p-4">
              <span class="grid size-7 shrink-0 place-items-center rounded-md border border-white/10 text-[11px] font-semibold text-zinc-300">
                {index + 1}
              </span>
              <div>
                <h4 class="text-sm font-semibold text-white">{step.title}</h4>
                <p class="mt-1 text-sm leading-relaxed text-zinc-400">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
