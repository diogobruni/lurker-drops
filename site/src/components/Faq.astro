---
import { Plus } from '@lucide/astro';
import type { Dictionary } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="faq" class="border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft">
        {dict.faq.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {dict.faq.title}
      </h2>
    </div>

    <div class="divide-y divide-white/5 border-y border-white/5">
      {
        dict.faq.items.map((item) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium text-zinc-200 transition-colors hover:text-white [&::-webkit-details-marker]:hidden">
              {item.q}
              <Plus
                size={16}
                class="shrink-0 text-zinc-400 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="pb-4 pr-8 text-sm leading-relaxed text-zinc-400">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
